# ==============================================================================
# SACHIN 'S DEMO COACHING — LEAD GENERATION & CRM INTEGRATION CONFIGURATION
# ==============================================================================

# 1. CRM / Lead Webhook Endpoint (e.g., Zapier, Make, HubSpot, Salesforce, Slack)
# When provided, all validated leads will be dispatched to this webhook via POST JSON.
# If omitted, leads are securely stored in the local server-side lead ledger.
LEAD_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/sample/sdc_leads"

# 2. Admissions Notification Recipient Email
LEAD_NOTIFICATION_EMAIL="admissions@sachinsdemocoaching.edu.sample"

# 3. Public Configurable WhatsApp Number for Floating Lead CTA
NEXT_PUBLIC_WHATSAPP_NUMBER="+919876543210"

# 4. Analytics & Event Telemetry (Optional Google Analytics / Tag Manager)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-SDCXXXXXXXX"
